# Public endpoint. DNS must resolve to this server before the first deployment.
DOMAIN=mlflow.example.com
ACME_EMAIL=admin@example.com
TZ=Asia/Kolkata
DEPLOYMENT_MODE=local

# Versions are intentionally pinned. Review release notes before changing them.
MLFLOW_VERSION=3.16.1
POSTGRES_VERSION=16-bookworm
CADDY_VERSION=2.10.2-alpine
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z

# Artifact storage. setup-minio.sh changes this to minio.
ARTIFACT_STORE=local
MINIO_BUCKET=mlflow-artifacts
MINIO_MEMORY_LIMIT=512m
MINIO_CPU_LIMIT=0.75

# Database identifiers must contain only letters, numbers, and underscores.
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow

# Small-server defaults. Raise these only after measuring usage.
MLFLOW_WORKERS=2
MLFLOW_MEMORY_LIMIT=1536m
MLFLOW_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=1.0
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.5

# Maximum single HTTP request accepted by Caddy (for artifact uploads).
MAX_REQUEST_BODY_SIZE=10GB

# Filled automatically by scripts/init-config.sh.
MLFLOW_UID=1000
MLFLOW_GID=1000

# Used only by scripts/deploy-local.sh for no-DNS SSH-tunnel deployments.
MLFLOW_LOCAL_PORT=5000

# Used only by scripts/deploy-vpn.sh. Set this to an IP assigned to the
# server's VPN interface; Docker binds the published port to this IP only.
MLFLOW_VPN_IP=
MLFLOW_VPN_PORT=5000

# Used only by scripts/deploy-lan.sh. Assign a static private address to the
# server and set it here; Docker will not bind MLflow to other interfaces.
MLFLOW_LAN_IP=
MLFLOW_LAN_PORT=5000

# Backups remain local until copied to encrypted off-server storage.
BACKUP_RETENTION_DAYS=30

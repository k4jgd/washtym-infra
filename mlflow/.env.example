TZ=Asia/Kolkata

# Versions are intentionally pinned. Review release notes before changing them.
MLFLOW_VERSION=3.16.1
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z

# MinIO stores every MLflow model and artifact.
MINIO_BUCKET=mlflow-artifacts
MINIO_MEMORY_LIMIT=512m
MINIO_CPU_LIMIT=0.75

# Database identifiers must contain only letters, numbers, and underscores.
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow

# Small-server defaults. Raise these only after measuring usage.
MLFLOW_WORKERS=2
MLFLOW_MEMORY_LIMIT=1536m
MLFLOW_CPU_LIMIT=2.0

# Filled automatically by scripts/init-config.sh.
MLFLOW_UID=1000
MLFLOW_GID=1000

# Assign a static private address to the server. Docker publishes MLflow only
# on this LAN address; MinIO and PostgreSQL remain private inside Docker.
MLFLOW_LAN_IP=
MLFLOW_LAN_PORT=5000

# Backups remain local until copied to encrypted off-server storage.
BACKUP_RETENTION_DAYS=30

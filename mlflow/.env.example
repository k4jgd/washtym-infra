# Public endpoint. DNS must resolve to this server before the first deployment.
DOMAIN=mlflow.example.com
ACME_EMAIL=admin@example.com
TZ=Asia/Kolkata

# Versions are intentionally pinned. Review release notes before changing them.
MLFLOW_VERSION=3.16.1
POSTGRES_VERSION=16-bookworm
CADDY_VERSION=2.10.2-alpine

# Database identifiers must contain only letters, numbers, and underscores.
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow

# Small-server defaults. Raise these only after measuring usage.
MLFLOW_WORKERS=2
MLFLOW_MEMORY_LIMIT=1536m
MLFLOW_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=1.0
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.5

# Maximum single HTTP request accepted by Caddy (for artifact uploads).
MAX_REQUEST_BODY_SIZE=10GB

# Filled automatically by scripts/init-config.sh.
MLFLOW_UID=1000
MLFLOW_GID=1000

# Backups remain local until copied to encrypted off-server storage.
BACKUP_RETENTION_DAYS=30


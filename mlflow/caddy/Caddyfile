{
	email {$ACME_EMAIL}
	admin off
}

# Other services on this host add one site file each. The shared edge network
# lets this single Caddy instance route multiple HTTPS domains without exposing
# application ports directly on the host.
import /etc/caddy/sites/*.caddy

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size {$MAX_REQUEST_BODY_SIZE}
	}

	reverse_proxy mlflow:5000 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format json
	}
}

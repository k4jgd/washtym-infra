TZ=Asia/Kolkata

# Static office-LAN address and HTTP port for Airflow.
AIRFLOW_LAN_IP=
AIRFLOW_LAN_PORT=8080

# Current stable release at the time this stack was created.
AIRFLOW_VERSION=3.3.2

# Database identifiers may contain only letters, numbers, and underscores.
POSTGRES_DB=airflow
POSTGRES_USER=airflow

# Filled by scripts/init-config.sh to match the Linux deployment user.
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Conservative limits for an 8-core host. Airflow itself receives about 4 GB.
AIRFLOW_PARALLELISM=2
AIRFLOW_API_WORKERS=1
AIRFLOW_API_MEMORY_LIMIT=768m
AIRFLOW_API_CPU_LIMIT=1.0
AIRFLOW_SCHEDULER_MEMORY_LIMIT=1536m
AIRFLOW_SCHEDULER_CPU_LIMIT=2.0
AIRFLOW_DAG_PROCESSOR_MEMORY_LIMIT=512m
AIRFLOW_DAG_PROCESSOR_CPU_LIMIT=0.5
AIRFLOW_TRIGGERER_MEMORY_LIMIT=384m
AIRFLOW_TRIGGERER_CPU_LIMIT=0.5
BACKUP_RETENTION_DAYS=30
